# Copia este archivo como ".env" y rellena los valores. El ".env" real NO se sube a GitHub.
ANTHROPIC_API_KEY=
# Opcional: cambiar de modelo
# CLAUDE_MODEL=claude-haiku-5-5
# Solo para server.py (la URL y la clave "publishable" de Supabase son públicas)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Solo desarrollo: poner a 1 activa el modo debug de Flask (NO usar en producción)
# FLASK_DEBUG=0

# Voz del asistente (ElevenLabs). Solo en el servidor: nunca en index.html ni en el navegador
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcionales: modelo y ajustes de voz (entre 0 y 1)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
